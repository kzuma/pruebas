# === MCP Server ===
OAUTH_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
OAUTH_TOKEN_EXPIRE_MINUTES=60
MCP_SERVER_NAME=rag-mcp-server
ALLOWED_ORIGINS=*

# Admin user for the OAuth demo login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# === RAG Service ===
EMBEDDING_MODEL=all-MiniLM-L6-v2
COLLECTION_NAME=documents
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# === Qdrant ===
# Qdrant runs on localhost:6333 (no auth needed by default)
# For production, enable Qdrant API key:
# QDRANT_API_KEY=your-qdrant-api-key

# === Google Drive ===
# Place your Google Service Account credentials JSON at:
# ./credentials/google_credentials.json
#
# Or set OAuth credentials:
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
#
# Shared Drive / Folder ID to index (optional):
# GOOGLE_DRIVE_FOLDER_ID=your-folder-id
